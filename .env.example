# Claude subscription auth — run `claude setup-token` once and paste the token here.
# NO ANTHROPIC_API_KEY needed; this uses your Claude Pro/Max subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Telegram (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to the bot (empty = anyone — not recommended)
TELEGRAM_ALLOWED_USER_IDS=

# Slack (Socket Mode app: bot token xoxb-..., app-level token xapp-... with connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Paths (defaults shown)
#AIOS_VAULT_PATH=/Users/you/Desktop/AI-Vault
#AIOS_VAULT_SUBDIR=AIOS
#AIOS_PROJECTS_ROOT=/Users/you/projects
#AIOS_DATA_DIR=./data

# Finance agent (IDAMA)
# Bind a group chat to the finance agent: "channel:chatId=finance" (comma-separated for more).
# Get the chat id from the daemon log after messaging in the group.
#AIOS_CHAT_BINDINGS=telegram:-1001234567890=finance
#AIOS_FINANCE_COMPANY=IDAMA
# The members sharing costs equally (settlement divides by this list's length):
# Format: LedgerName:platform_username (handle optional) — handle enables auto-attribution of "I paid X" messages.
#AIOS_FINANCE_MEMBERS=Ihab:theAmsterdamer,Amr:amr_tg,Sara,Omar,Lina

# Tuning
#AIOS_MAX_CONCURRENT_JOBS=1
#AIOS_JOB_WALL_TIME_MS=7200000
#AIOS_MODERATOR_MODEL=
#AIOS_SPECIALIST_MODEL=
