# Claude subscription auth — run `claude setup-token` once and paste the token here.
# NO ANTHROPIC_API_KEY needed; this uses your Claude Pro/Max subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Telegram (create bot via @BotFather)
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to the bot (empty = anyone — not recommended)
TELEGRAM_ALLOWED_USER_IDS=

# Slack (Socket Mode app: bot token xoxb-..., app-level token xapp-... with connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Paths (defaults shown)
#AIOS_VAULT_PATH=/Users/you/AIOS/workspace
#AIOS_VAULT_SUBDIR=AIOS
#AIOS_PROJECTS_ROOT=/Users/you/projects
#AIOS_DATA_DIR=./data

# Finance agent
# Bind a group chat to the finance agent: "channel:chatId=finance" (comma-separated for more).
# Get the chat id from the daemon log after messaging in the group.
#AIOS_CHAT_BINDINGS=telegram:-1001234567890=finance
# Your company name, quoted in the bookkeeper's prompt. Empty by default.
#AIOS_FINANCE_COMPANY=YourCompany
# The members sharing costs equally (settlement divides by this list's length):
# Format: LedgerName:platform_username (handle optional) — handle enables auto-attribution of "I paid X" messages.
#AIOS_FINANCE_MEMBERS=Ada:ada_tg,Grace,Alan

# A client project one of your agents works inside. Both are required or the wiring is skipped
# entirely — a half-configured client is not a client. AIOS_CLIENT_AGENT is the agent's name in
# your org; AIOS_CLIENT_DIR is its working directory. Unset by default: an agent with no working
# directory fails with a named error rather than silently pointing at nothing.
#AIOS_CLIENT_AGENT=acme
#AIOS_CLIENT_DIR=/Users/you/projects/acme

# The read-only AWS surface that client agent may reach, via the `aws-readonly` guard. These name
# YOUR infrastructure, so they are config, not code. Unset means the guard denies every aws
# command — it fails closed and says which variable is missing.
#AIOS_AWS_READONLY_PROFILES=acme,acme-staging
#AIOS_AWS_READONLY_INSTANCES=i-0123456789abcdef0

# Where an aws-readonly agent may write its deliverables (CSV/report exports it then attaches).
#AIOS_EXPORTS_DIR=data/downloads

# Cloudflare edge analytics. The zone is identified by CLOUDFLARE_ZONE_ID; CLOUDFLARE_SITE is
# only its human name, used in the tool description.
#CLOUDFLARE_SITE=acme.example
#CLOUDFLARE_ZONE_ID=
#CLOUDFLARE_API_TOKEN=

# Tuning
#AIOS_MAX_CONCURRENT_JOBS=1
#AIOS_JOB_WALL_TIME_MS=7200000
#AIOS_MODERATOR_MODEL=
#AIOS_SPECIALIST_MODEL=
