        <mxCell id="title" value="AI-OS — Always-on Cognitive-Kernel Daemon (TypeScript · Claude Agent SDK · node:sqlite · subscription auth)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1a1a1a;" vertex="1" parent="1">
