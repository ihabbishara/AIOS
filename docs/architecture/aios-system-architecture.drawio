        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="chCli" target="router"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- router -> agents (fan) -->
        <mxCell id="e8" value="moderator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="modr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="@role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="direct"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="group" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="finance"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- agents -> engine -->
