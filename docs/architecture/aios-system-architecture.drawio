        <mxCell id="e24" value="execute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="registry" target="executors"><mxGeometry relative="1" as="geometry" /></mxCell>

