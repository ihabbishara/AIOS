        <!-- ===== CRITICAL NOTES PANEL ===== -->
        <mxCell id="notes" value="CRITICAL ARCHITECTURE NOTES&#xa;&#xa;✔ Single chokepoint — ALL outward effects funnel through ActionGate → ExecutorRegistry. Agents/packs cannot bypass (ceiling refuses unknown action types pre-gate).&#xa;✔ Earned autonomy — trust ledger gates per action-type; graduation needs explicit approval; reject/undo = instant demote; hard ceilings can't be flipped.&#xa;✔ Privacy walls — personal_* (bank) + inbound email content NEVER indexed into recall; money pack is private-chat only; dream/speculate exclude money+email by construction.&#xa;✔ Resilience — heartbeat fire-and-forget + try/caught clock loop; per-account watcher backoff; fail-silent dream/speculate; claim-before-execute + startup stale-recovery.&#xa;&#xa;⚠ Cross-cutting coupling — EventBus + Store touched by nearly every module (god-object risk; edges omitted, shown as rails →).&#xa;⚠ 60s SDK limit — long work must NOT run in MCP tool handlers → JobManager enqueues; engine notifies moderator on completion.&#xa;⚠ Concurrency-1 queue — serial overnight research; no token/cost-budget enforcement yet (K-job cap only).&#xa;⚠ Uncommitted pdf-attachments WIP in the working tree (out of this diagram's scope)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="315" width="940" height="280" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES (clean: adjacent flow only) ===================== -->
        <!-- external -> channels -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exTg" target="chTg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exSlack" target="chSlack"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exCli" target="chCli"><mxGeometry relative="1" as="geometry" /></mxCell>

